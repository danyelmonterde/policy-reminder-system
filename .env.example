# Application Port Config
FRONTEND_PORT=8081

# MySQL Configuration for Docker Compose
MYSQL_DATABASE=mypolicy_db
MYSQL_ROOT_PASSWORD=your_mysql_root_password
MYSQL_USER=mypolicy_user
MYSQL_PASSWORD=your_mysql_password

# Spring Datasource (for local running outside docker)
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/mypolicy_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=your_mysql_password

# Mail SMTP Configuration
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your_gmail@gmail.com
SPRING_MAIL_PASSWORD=your_gmail_app_password

# JWT Token Secret (Base64 HMAC-SHA256, at least 256 bits)
JWT_SECRET=your_base64_encoded_jwt_secret_key_at_least_256_bits
